#include "cache.h"

#include <limits>

#define SPP_IP_TABLE_SIZE 64
#define SPP_PATTERN_TABLE_SIZE 256
#define SPP_SIGNATURE_BITS 16
#define SPP_UNIFORM_CONFIDENCE 2

struct SPP_IP_ENTRY {
    uint64_t ip;
    uint64_t last_block;
    int64_t last_stride;
    uint16_t signature;
    uint8_t valid;
    uint8_t uniform_confidence;
};

struct SPP_PATTERN_ENTRY {
    int64_t next_stride;
    uint16_t signature;
    uint8_t valid;
    uint8_t confidence;
};

static SPP_IP_ENTRY ip_table[SPP_IP_TABLE_SIZE];
static SPP_PATTERN_ENTRY pattern_table[SPP_PATTERN_TABLE_SIZE];

static uint16_t advance_signature(uint16_t signature, int64_t stride)
{
    const uint16_t stride_code = static_cast<uint16_t>(static_cast<uint64_t>(stride));
    return static_cast<uint16_t>((signature << 5) | (signature >> (SPP_SIGNATURE_BITS - 5))) ^ stride_code;
}

static bool add_stride(uint64_t block, int64_t stride, uint64_t &next_block)
{
    if (stride >= 0) {
        const uint64_t amount = static_cast<uint64_t>(stride);
        if (amount > std::numeric_limits<uint64_t>::max() - block)
            return false;
        next_block = block + amount;
        return true;
    }

    const uint64_t amount = static_cast<uint64_t>(-(stride + 1)) + 1;
    if (amount > block)
        return false;
    next_block = block - amount;
    return true;
}

static SPP_PATTERN_ENTRY *find_pattern(uint16_t signature)
{
    SPP_PATTERN_ENTRY *entry = &pattern_table[signature % SPP_PATTERN_TABLE_SIZE];
    if (!entry->valid || entry->signature != signature)
        return NULL;
    return entry;
}

static uint32_t current_degree(const CACHE *cache)
{
    if (cache->pf_issued < 32)
        return 1;

    const double accuracy = static_cast<double>(cache->pf_useful) / cache->pf_issued;
    if (accuracy < 0.30)
        return 1;
    if (accuracy < 0.60)
        return 2;
    return 4;
}

void CACHE::l1d_prefetcher_initialize()
{
    for (uint32_t i = 0; i < SPP_IP_TABLE_SIZE; i++)
        ip_table[i] = SPP_IP_ENTRY();
    for (uint32_t i = 0; i < SPP_PATTERN_TABLE_SIZE; i++)
        pattern_table[i] = SPP_PATTERN_ENTRY();

    cout << "L1D SPP: 64 IP entries, 256 stride-signature entries" << endl;
}

void CACHE::l1d_prefetcher_operate(uint64_t addr, uint64_t ip, uint8_t cache_hit, uint8_t type, uint8_t critical_ip_flag)
{
    if (type != LOAD && type != RFO)
        return;

    const uint64_t block_addr = addr >> LOG2_BLOCK_SIZE;
    const uint32_t index = static_cast<uint32_t>(((ip >> 2) ^ (ip >> 11)) % SPP_IP_TABLE_SIZE);
    SPP_IP_ENTRY &tracker = ip_table[index];

    if (!tracker.valid || tracker.ip != ip) {
        tracker.valid = 1;
        tracker.ip = ip;
        tracker.last_block = block_addr;
        tracker.last_stride = 0;
        tracker.signature = 0xACE1;
        tracker.uniform_confidence = 0;
        return;
    }

    int64_t stride;
    if (block_addr >= tracker.last_block) {
        const uint64_t difference = block_addr - tracker.last_block;
        if (difference > static_cast<uint64_t>(std::numeric_limits<int64_t>::max())) {
            tracker.last_block = block_addr;
            tracker.last_stride = 0;
            tracker.signature = 0xACE1;
            tracker.uniform_confidence = 0;
            return;
        }
        stride = static_cast<int64_t>(difference);
    } else {
        const uint64_t difference = tracker.last_block - block_addr;
        if (difference > static_cast<uint64_t>(std::numeric_limits<int64_t>::max())) {
            tracker.last_block = block_addr;
            tracker.last_stride = 0;
            tracker.signature = 0xACE1;
            tracker.uniform_confidence = 0;
            return;
        }
        stride = -static_cast<int64_t>(difference);
    }

    if (stride == 0) {
        tracker.last_block = block_addr;
        return;
    }

    if (stride == tracker.last_stride) {
        if (tracker.uniform_confidence < 3)
            tracker.uniform_confidence++;
    } else {
        tracker.uniform_confidence = 0;
    }

    const uint16_t previous_signature = tracker.signature;
    SPP_PATTERN_ENTRY &pattern = pattern_table[previous_signature % SPP_PATTERN_TABLE_SIZE];
    if (!pattern.valid || pattern.signature != previous_signature) {
        pattern.valid = 1;
        pattern.signature = previous_signature;
        pattern.next_stride = stride;
        pattern.confidence = 0;
    } else if (pattern.next_stride == stride) {
        if (pattern.confidence < 3)
            pattern.confidence++;
    } else {
        pattern.next_stride = stride;
        pattern.confidence = 0;
    }

    tracker.signature = advance_signature(previous_signature, stride);
    tracker.last_block = block_addr;
    tracker.last_stride = stride;

    const uint32_t degree = current_degree(this);
    const uint64_t page_number = addr >> LOG2_PAGE_SIZE;
    const uint64_t blocks_per_page = 1ULL << (LOG2_PAGE_SIZE - LOG2_BLOCK_SIZE);
    uint64_t predicted_block = block_addr;

    if (tracker.uniform_confidence >= SPP_UNIFORM_CONFIDENCE) {
        for (uint32_t distance = 1; distance <= degree; distance++) {
            if (!add_stride(predicted_block, stride, predicted_block) ||
                predicted_block / blocks_per_page != page_number)
                break;

            const uint64_t prefetch_address = predicted_block << LOG2_BLOCK_SIZE;
            const int fill_level = (MSHR.occupancy < (MSHR.SIZE >> 1)) ? FILL_L1 : FILL_L2;
            prefetch_line(ip, addr, prefetch_address, fill_level, 0);
        }
        return;
    }

    uint16_t predicted_signature = tracker.signature;
    for (uint32_t distance = 0; distance < degree; distance++) {
        SPP_PATTERN_ENTRY *next_pattern = find_pattern(predicted_signature);
        if (next_pattern == NULL || next_pattern->confidence < 1)
            break;

        if (!add_stride(predicted_block, next_pattern->next_stride, predicted_block) ||
            predicted_block / blocks_per_page != page_number)
            break;

        const uint64_t prefetch_address = predicted_block << LOG2_BLOCK_SIZE;
        const int fill_level = (MSHR.occupancy < (MSHR.SIZE >> 1)) ? FILL_L1 : FILL_L2;
        prefetch_line(ip, addr, prefetch_address, fill_level, 0);
        predicted_signature = advance_signature(predicted_signature, next_pattern->next_stride);
    }
}

void CACHE::l1d_prefetcher_notify_about_dtlb_eviction(uint64_t addr, uint32_t set, uint32_t way, uint8_t prefetch, uint64_t evicted_addr, uint32_t metadata_in)
{
}

void CACHE::l1d_prefetcher_cache_fill(uint64_t v_addr, uint64_t addr, uint32_t set, uint32_t way, uint8_t prefetch, uint64_t v_evicted_addr, uint64_t evicted_addr, uint32_t metadata_in)
{
}

void CACHE::l1d_prefetcher_final_stats()
{
    cout << "L1D SPP storage: IP table " << SPP_IP_TABLE_SIZE << " x "
         << sizeof(SPP_IP_ENTRY) << " B, signature table " << SPP_PATTERN_TABLE_SIZE
         << " x " << sizeof(SPP_PATTERN_ENTRY) << " B, total "
         << sizeof(ip_table) + sizeof(pattern_table)
         << " bytes allocated; logical fields: 34,752 bits" << endl;
}
