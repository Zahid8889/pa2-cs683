#include "cache.h"

#define IP_SIZE 64
#define SIG_SIZE 4096
#define SIG_MASK 0xFFF
#define SIG_SHIFT 3
#define MAX_CONF 3
#define PAGE_LINES 64
#define ACCURACY_WINDOW 256
#define HISTORY_SIZE 5

struct IPEntry {
    uint64_t ip;
    uint64_t last_line;
    uint64_t last_page;
    uint16_t sig;
    int last_stride;
    int conf;
    int history[HISTORY_SIZE];
    int history_count;
    bool valid;
};


struct SigEntry {
    int stride;
    int conf;
    bool valid;
};


int degree = 4;
uint64_t last_issued = 0;
uint64_t last_useful = 0;

IPEntry ip_table[IP_SIZE];
SigEntry sig_table[SIG_SIZE];

uint16_t next_sig(uint16_t sig, int stride)
{
    return ((sig << SIG_SHIFT) ^ (stride & 0x7F)) & SIG_MASK;
}



void CACHE::l1d_prefetcher_initialize() 
{
    std::cout << "------------------------------------------------" << std::endl;
    std::cout << "        Stride Pattern Prefetcher (SPP)         " << std::endl;
    std::cout << "------------------------------------------------" << std::endl;

    for (int i = 0; i < IP_SIZE; i++)
        ip_table[i] = IPEntry{};

    for (int i = 0; i < SIG_SIZE; i++)
        sig_table[i] = SigEntry{};

    degree = 4;
    last_issued = pf_lower_level;
    last_useful = pf_useful;

}

void CACHE::l1d_prefetcher_operate(uint64_t addr, uint64_t ip, uint8_t cache_hit, uint8_t type, uint8_t critical_ip_flag)
{
   
    if (type == PREFETCH)
        return;


    if (pf_lower_level < last_issued || pf_useful < last_useful) {
        last_issued = pf_lower_level;
        last_useful = pf_useful;
    }

    uint64_t issued = pf_lower_level - last_issued;

    if (issued >= ACCURACY_WINDOW) {
        double accuracy =
            static_cast<double>(pf_useful - last_useful) / issued;

        if (accuracy >= 0.75)
            degree = 6;
        else if (accuracy >= 0.50)
            degree = 4;
        else if (accuracy >= 0.25)
            degree = 2;
        else
            degree = 1;

        last_issued = pf_lower_level;
        last_useful = pf_useful;
    }

    uint64_t line = addr >> LOG2_BLOCK_SIZE;
    uint64_t page = addr >> LOG2_PAGE_SIZE;
    int offset = line & (PAGE_LINES - 1);

    IPEntry &entry = ip_table[ip % IP_SIZE];


    if (!entry.valid || entry.ip != ip) {
        entry = IPEntry{};
        entry.valid = true;
        entry.ip = ip;
        entry.last_line = line;
        entry.last_page = page;
        return;
    }


    if (entry.last_page != page) {
        entry.last_line = line;
        entry.last_page = page;
        entry.sig = 0;
        entry.last_stride = 0;
        entry.conf = 0;
        entry.history_count = 0;
        return;
    }

    int stride;

    if (line >= entry.last_line)
        stride = static_cast<int>(line - entry.last_line);
    else
        stride = -static_cast<int>(entry.last_line - line);

    if (stride == 0)
        return;


    if (entry.history_count < HISTORY_SIZE) {
        entry.history[entry.history_count++] = stride;
    } else {
        for (int i = 0; i < HISTORY_SIZE - 1; i++)
            entry.history[i] = entry.history[i + 1];

        entry.history[HISTORY_SIZE - 1] = stride;
    }


    if (stride == entry.last_stride) {
        if (entry.conf < MAX_CONF)
            entry.conf++;
    } else if (entry.conf > 0) {
        entry.conf--;
    }


    uint16_t old_sig = entry.sig;
    old_sig &= SIG_MASK;
    SigEntry &pattern = sig_table[old_sig];

    if (!pattern.valid) {
        pattern.valid = true;
        pattern.stride = stride;
        pattern.conf = 1;
    } else if (pattern.stride == stride) {
        if (pattern.conf < MAX_CONF)
            pattern.conf++;
    } else if (pattern.conf > 0) {
        pattern.conf--;
    } else {
        pattern.stride = stride;
        pattern.conf = 1;
    }

    entry.sig = next_sig(old_sig, stride);

    entry.last_line = line;
    entry.last_page = page;
    entry.last_stride = stride;


    bool uniform = entry.history_count >= 3;

    if (uniform) {
        for (int i = 1; i < entry.history_count; i++) {
            if (entry.history[i] != entry.history[0]) {
                uniform = false;
                break;
            }
        }
    }

    int target = offset;


    if (uniform && entry.conf >= 2) {
        for (int i = 0; i < degree; i++) {
            target += stride;

            if (target < 0 || target >= PAGE_LINES)
                break;

            uint64_t pf_addr =
                (page << LOG2_PAGE_SIZE) +
                (static_cast<uint64_t>(target) << LOG2_BLOCK_SIZE);

            uint32_t fill_level =
                (MSHR.occupancy < (MSHR.SIZE >> 1))
                ? FILL_L1 : FILL_L2;

            prefetch_line(ip, addr, pf_addr, fill_level, 0);
        }

        return;
    }


    uint16_t sig = entry.sig;
    target = offset;

    for (int i = 0; i < degree; i++) {
        sig &= SIG_MASK;
        SigEntry &next = sig_table[sig];

        if (!next.valid || next.conf < 1)
            break;

        target += next.stride;

        if (target < 0 || target >= PAGE_LINES)
            break;

        uint64_t pf_addr =
            (page << LOG2_PAGE_SIZE) +
            (static_cast<uint64_t>(target) << LOG2_BLOCK_SIZE);

        uint32_t fill_level =
            (MSHR.occupancy < (MSHR.SIZE >> 1))
            ? FILL_L1 : FILL_L2;

        prefetch_line(ip, addr, pf_addr, fill_level, 0);

        sig = next_sig(sig, next.stride);
    }
}

void CACHE::l1d_prefetcher_cache_fill(uint64_t v_addr, uint64_t addr, uint32_t set, uint32_t way, uint8_t prefetch, uint64_t v_evicted_addr, uint64_t evicted_addr, uint32_t metadata_in)
{
	return; //metadata_in;
}

void CACHE::l1d_prefetcher_final_stats()
{

     std::cout << "Prefetch degree: " << degree << std::endl;
}