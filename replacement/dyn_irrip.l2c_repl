#include "cache.h"

#define MAX_RRPV 3

// A few leader sets that always use normal RRIP
#define LEADER_SET_COUNT 8

uint32_t l2_rrpv[L2C_SET][L2C_WAY];

// To keep count of how many times our policy changed for follower sets (completely for fun statistical purpose)
uint64_t switches = 0;

// Leader-set statistics
uint64_t instr_accesses = 0;
uint64_t data_accesses = 0;

uint64_t instr_misses = 0;
uint64_t data_misses = 0;


// Current policy for non-leader sets
// 0 = RRIP
// 1 = I-RRIP
bool use_irrip = false;



// Select leader set 
bool is_leader_set(uint32_t set)
{
    // Simple deterministic selection
    return (set % (L2C_SET / LEADER_SET_COUNT)) == 0;
}


// Initialize
void CACHE::l2c_initialize_replacement()
{
    cout << "------------------- Initialize Dynamic I-RRIP state for L2C -------------------" << endl;

    for(int i = 0; i < L2C_SET; i++){
        for(int j = 0; j < L2C_WAY; j++){
            l2_rrpv[i][j] = MAX_RRPV;
        }
    }

    instr_accesses = 0;
    data_accesses = 0;
    instr_misses = 0;
    data_misses = 0;
    switches = 0;

    use_irrip = false;
}


// Find victim

uint32_t CACHE::l2c_find_victim(uint32_t cpu, uint64_t instr_id, uint32_t set, const BLOCK *current_set, uint64_t ip, uint64_t full_addr, uint32_t type){
    
    while(1){
        // Leader sets always use normal RRIP
        if(is_leader_set(set) || !use_irrip){

            for(int i = 0; i < L2C_WAY; i++){
                if(l2_rrpv[set][i] == MAX_RRPV)
                    return i;
            }
        }

        // Non-leader set using I-RRIP
        else{

            // Prefer data lines at MAX_RRPV
            for(int i = 0; i < L2C_WAY; i++){
                if(l2_rrpv[set][i] == MAX_RRPV &&
                   !current_set[i].instruction){

                    return i;
                }
            }

            // No data victim so take from instruction if any
            for(int i = 0; i < L2C_WAY; i++){
                if(l2_rrpv[set][i] == MAX_RRPV)
                    return i;
            }
        }


        // No immediate victim so age all
        for(int i = 0; i < L2C_WAY; i++){
            if(l2_rrpv[set][i] < MAX_RRPV)
                l2_rrpv[set][i]++;
        }
    }

    // should never reach here
    assert(0);
    return 0;
}


// Update replacement state

void CACHE::l2c_update_replacement_state(uint32_t cpu, uint32_t set, uint32_t way, uint64_t full_addr, uint64_t ip, uint64_t victim_addr, uint32_t type, uint8_t hit, uint8_t isInstruction){
    
    // Update leader-set statistics
    if(is_leader_set(set)){

        if(isInstruction){
            instr_accesses++;

            if(!hit)
                instr_misses++;
        }
        else{
            data_accesses++;

            if(!hit)
                data_misses++;
        }


        // decision formula
        uint64_t total_accesses = instr_accesses + data_accesses;

        uint64_t total_misses = instr_misses + data_misses;

        if(total_accesses + total_misses > 0){

            double score = (double)(instr_accesses + instr_misses) / (double)(total_accesses + total_misses);

            if(score > 0.25){
                if(!use_irrip){
                    switches++;
                }
                use_irrip = true;
            }
            else{
                if(use_irrip){
                    switches++;
                }
                use_irrip = false;
            }
        }
    }


    // Leader sets always use RRIP

    if(is_leader_set(set)){

        if(hit)
            l2_rrpv[set][way] = 0;
        else
            l2_rrpv[set][way] = MAX_RRPV - 1;

        return;
    }


    // Follower sets

    if(!use_irrip){

        // Normal RRIP
        if(hit)
            l2_rrpv[set][way] = 0;
        else
            l2_rrpv[set][way] = MAX_RRPV - 1;
    }

    else{

        // Dynamic I-RRIP
        if(hit){

            // Instruction gets stronger protection
            if(isInstruction)
                l2_rrpv[set][way] = 0;
            else
                l2_rrpv[set][way] = 1;
        }
        else{

            // Instruction inserted closer to MRU
            if(isInstruction)
                l2_rrpv[set][way] = MAX_RRPV-2;
            else
                l2_rrpv[set][way] = MAX_RRPV-1;
        }
    }
}


// Final statistics
void CACHE::l2c_replacement_final_stats()
{
    uint64_t total_accesses =
        instr_accesses + data_accesses;

    uint64_t total_misses =
        instr_misses + data_misses;

    double score = 0.0;

    if(total_accesses + total_misses > 0){
        score = (double)(instr_accesses + instr_misses) / (double)(total_accesses + total_misses);
    }

    cout << "------- Final stats ------" <<endl;
    cout << "Dynamic I-RRIP final stats" << endl;
    cout << "Instruction accesses: " << instr_accesses << endl;
    cout << "Data accesses: " << data_accesses << endl;
    cout << "Instruction misses: " << instr_misses << endl;
    cout << "Data misses: " << data_misses << endl;
    cout << "Instruction score: " << score << endl;

    cout<< "Number of policy switches: "<< switches <<endl;

    if(use_irrip)
        cout << "Final policy: I-RRIP" << endl;
    else
        cout << "Final policy: RRIP" << endl;
}